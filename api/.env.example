# cp .env.example .env して使う
PORT=4000

# docker compose の PostgreSQL（compose.yaml）
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=java_learning
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/java_learning

# 実行サーバー（../runner）。RUNNER_TOKEN は実行サーバーの .env と同じ値にする
RUNNER_URL=http://localhost:5000
RUNNER_TOKEN=dev-runner-token

# 画面（web）のオリジン。状態を変えるリクエストはこのオリジンからのものだけ受け付ける
WEB_ORIGIN=http://localhost:3000

# npm run db:seed で作る開発用アカウントの初期パスワード
SEED_INITIAL_PASSWORD=initial-pass

# web（Next.js）経由で届く X-Forwarded-For を接続元 IP として使う（ログイン試行回数の制限用）
TRUST_PROXY=true
